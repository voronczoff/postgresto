# =============================================================================
# Non-DB configuration (product title/menu/views live in Postgres via Liquibase)
# Copy to .env and adjust.
# =============================================================================

# --- Compose project / container name prefix ---
AppName=postgresto

# --- PostgREST API (this process / this deploy) ---
# Other environments are UI links in config.jsondata.envSwitcher
# Leave empty for both ./launch.sh (Vite proxies $VITE_BASE_PATH/api → :3000)
# and docker nginx (same-origin $VITE_BASE_PATH/api). Set only to force a remote API.
POSTGREST_API_BASE=
# Optional Vite→PostgREST proxy target when POSTGREST_API_BASE is empty
# POSTGREST_DEV_PROXY_TARGET=http://127.0.0.1:3000

# --- Keycloak / OIDC (SPA frontend login gate) ---
# ON:  set both VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID
# OFF: clear VITE_OIDC_AUTHORITY (or either var) — AuthGate skips login; no account menu
# Dev: restart Vite after change (values from .env).
# Prod dist: not baked into the JS — docker nginx injects <meta> from these vars
#   (or `./scripts/setDistOidc.sh "$VITE_OIDC_AUTHORITY" "$VITE_OIDC_CLIENT_ID"`).
# See docs/authentication.md
# VITE_OIDC_AUTHORITY=https://keycloak/realms/master
# VITE_OIDC_CLIENT_ID=postgresto
# OFF example:
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=

# --- PostgREST JWT (API auth; independent of the SPA gate) ---
# Default DB role (no JWT / db-anon-role) is postgres — not the limited `anon` role.
# ON:  set PGRST_JWT_SECRET (single-quoted JWKS JSON). JWT claim role=authenticated still applies.
#      ./postgrest.sh and Docker Compose enable JWT only when PGRST_JWT_SECRET is non-empty.
# OFF: unset/comment PGRST_JWT_SECRET (and optionally clear VITE_OIDC_*). Restart postgrest / compose.
# Refresh JWKS: https://keycloak/realms/master/protocol/openid-connect/certs
#PGRST_DB_ANON_ROLE=postgres
#PGRST_JWT_ROLE_CLAIM_KEY=$.role
#PGRST_JWT_SECRET='{"keys":[{"kid":"qwe","kty":"RSA","alg":"RS256","use":"sig","x5c":["qwe"],"x5t":"qwe","qwe":"qwe","n":"qwe","e":"AQAB"}]}'
# OFF example (JWT + SPA gate off; restart compose / postgrest):
VITE_OIDC_AUTHORITY=
PGRST_JWT_SECRET=

# --- App mount path (nginx / Vite dev only; NOT baked into production dist) ---
# Production builds emit relative asset URLs so one dist can be hosted anywhere.
# Docker nginx mounts dist here and injects <base href="$VITE_BASE_PATH/">
# plus OIDC <meta> from VITE_OIDC_*.
# Other hosts: run `./scripts/setDistBasePath.sh /your/path` and
# `./scripts/setDistOidc.sh "$VITE_OIDC_AUTHORITY" "$VITE_OIDC_CLIENT_ID"` on dist/index.html.
VITE_BASE_PATH=/postgresto

# --- Local Postgres (Liquibase / PostgREST / launch / docker compose) ---
#PGHOST=host.docker.internal
#PGHOST=localhost
PGHOST=dbms
PGPORT=5432
POSTGRES_PUBLIC_PORT=54321
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgresto-local
# Comma-separated application schemas exposed by PostgREST. Framework tables
# always live in the fixed `postgresto` schema.
PGSCHEMAS=postgresto,docs,public

# --- Vite dev server (./launch.sh) ---
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=true

# --- Docker image versions (docker compose) — pin to major (or latest of that major) ---
POSTGRES_VERSION=18
POSTGREST_VERSION=v16.4
NGINX_VERSION=latest
SWAGGER_UI_VERSION=latest
LIQUIBASE_VERSION=5.0

# Public API URL advertised by PostgREST for Swagger UI's "Try it out".
# Default follows VITE_BASE_PATH at http://localhost:7777. Override for remote hosts.
# PGRST_OPENAPI_SERVER_PROXY_URI=https://example.com/postgresto/api

# Docker: npm run build && docker compose up → http://localhost:7777$VITE_BASE_PATH/
# (compose uses PG* above for postgres/migrate/postgrest; nginx mounts ./dist on 7777)
