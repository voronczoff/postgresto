<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

	<!-- Load formatted-SQL changelogs directly in each folder, excluding nested folders. -->
	<includeAll path="schema" relativeToChangelogFile="true" maxDepth="1"/>
	<includeAll path="functions" relativeToChangelogFile="true" maxDepth="1"/>
	<includeAll path="triggers" relativeToChangelogFile="true" maxDepth="1"/>
	<includeAll path="menu" relativeToChangelogFile="true" maxDepth="1"/>
	<includeAll path="views" relativeToChangelogFile="true" maxDepth="1"/>
	<includeAll path="data" relativeToChangelogFile="true" maxDepth="1"/>

	<!-- config last because of index rebuild must be applied after all data is loaded -->
	<includeAll path="config" relativeToChangelogFile="true" maxDepth="1"/>

</databaseChangeLog>
